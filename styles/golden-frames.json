{
  "name": "golden-frames",
  "description": "Vlog cinematográfico quente e calmo: cortes nas frases, normalização por cena + look de cinema com halation.",
  "rhythm": {
    "min_shot": 0.9,
    "intro_shot": [2.5, 3.5],
    "body_shot": [1.8, 2.6],
    "intro_push": 0.05
  },
  "normalize": {
    "black_factor": 0.85,
    "black_max": 0.16,
    "white_factor": 1.02,
    "white_min": 0.70,
    "night_median": 0.30,
    "mid_target_day": 0.46,
    "mid_target_night": 0.30,
    "gamma_range": [0.80, 1.30],
    "wb_strength_day": 0.55,
    "wb_strength_night": 0.35,
    "sat_target_day": 0.40,
    "sat_target_night": 0.34,
    "sat_range": [0.70, 1.55]
  },
  "look": [
    "curves=master='0/0.035 0.12/0.09 0.30/0.27 0.50/0.50 0.72/0.75 0.90/0.90 1/0.955'",
    "colorbalance=rs=-0.05:gs=0.01:bs=0.06:rm=0.02:gm=0.0:bm=-0.02:rh=0.05:gh=0.01:bh=-0.05:pl=1",
    "huesaturation=hue=-10:saturation=-0.12:colors=b+c",
    "huesaturation=hue=8:saturation=-0.22:colors=g",
    "huesaturation=hue=-3:saturation=0.04:colors=r+y"
  ],
  "halation": {"threshold": 0.70, "sigma_at_1080": 18, "tint": [1.0, 0.55, 0.35], "opacity": 0.22},
  "finish": ["vignette=angle=PI/4.5:mode=forward", "noise=alls=4:allf=t+u"],
  "typography": {
    "number_font": "BOD_R.TTF",
    "caps_font": "GIL_____.TTF",
    "italic_font": "GARAIT.TTF",
    "fallback_fonts": ["georgia.ttf", "times.ttf"],
    "open": {"number_size": 230, "caps_size": 34, "caps_tracking": 26, "start": 0.4, "end": 3.0},
    "close": {"caps_size": 24, "caps_tracking": 14, "italic_size": 96, "lead": 3.4, "tail": 0.3},
    "shadow": {"blur": 12, "opacity": 0.8},
    "drift_px": 10
  },
  "audio": {"fade_in": 0.3, "fade_out": 2.0},
  "video": {"fade_in": 0.8, "fade_out": 1.2, "fps": "24000/1001"}
}
